        <path android:fillColor="#FFFFFFFF"
            android:pathData="M7,13 A1,1 0 1 0 7,15 A1,1 0 1 0 7,13 Z" />
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M19,13 A1,1 0 1 0 19,15 A1,1 0 1 0 19,13 Z" />
    </group>
</vector>