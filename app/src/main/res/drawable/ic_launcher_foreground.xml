<?xml version="1.0" encoding="utf-8"?>
<!--
  Glyph: "keyboard" by Tabler Icons (MIT). https://tabler.io/icons
  Converted from the 24x24 outline SVG: stroke geometry kept as-is, and the
  zero-length "l0 .01" key dots replaced with filled circles of the same
  radius (r = strokeWidth / 2 = 1, so a dot is exactly as wide as the outline),
  since VectorDrawable does not reliably render zero-length stroked subpaths.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glyph occupies x 27..81, y 38..70: centred, inside the 72dp safe zone. -->
    <group
        android:scaleX="2.7"
        android:scaleY="2.7"
        android:translateX="21.6"
        android:translateY="21.6">

        <path
            android:pathData="M2,8 A2,2 0 0 1 4,6 L20,6 A2,2 0 0 1 22,8 L22,16 A2,2 0 0 1 20,18 L4,18 A2,2 0 0 1 2,16 Z"
            android:strokeColor="@color/launcher_glyph"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- spacebar -->
        <path
            android:pathData="M10,14 L14,14"
            android:strokeColor="@color/launcher_glyph"
            android:strokeWidth="2"
            android:strokeLineCap="round" />

        <!-- keys: absolute arcs, fillColor on each path rather than inherited -->
        <path android:fillColor="@color/launcher_glyph"
            android:pathData="M6,9 A1,1 0 1 0 6,11 A1,1 0 1 0 6,9 Z" />
        <path android:fillColor="@color/launcher_glyph"
            android:pathData="M10,9 A1,1 0 1 0 10,11 A1,1 0 1 0 10,9 Z" />
        <path android:fillColor="@color/launcher_glyph"
            android:pathData="M14,9 A1,1 0 1 0 14,11 A1,1 0 1 0 14,9 Z" />
        <path android:fillColor="@color/launcher_glyph"
            android:pathData="M18,9 A1,1 0 1 0 18,11 A1,1 0 1 0 18,9 Z" />
        <path android:fillColor="@color/launcher_glyph"
            android:pathData="M6,13 A1,1 0 1 0 6,15 A1,1 0 1 0 6,13 Z" />
        <path android:fillColor="@color/launcher_glyph"
            android:pathData="M18,13 A1,1 0 1 0 18,15 A1,1 0 1 0 18,13 Z" />
    </group>
</vector>